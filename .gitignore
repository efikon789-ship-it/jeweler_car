# Переменные окружения — никогда не коммитить
.env

# Виртуальное окружение Python
venv/
.venv/
env/
ENV/

# Кэш Python
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# Дистрибутивы и сборки
dist/
build/
*.egg-info/

# Системные файлы
.DS_Store
Thumbs.db
desktop.ini

# Файлы редакторов
.vscode/
.idea/
*.swp
*.swo

# Логи
*.log

# Временные файлы
*.tmp
*.bak
