# Скопируй этот файл в .env и заполни реальными значениями
# НИКОГДА не коммить .env в Git

# Telegram Bot — для получения заявок с сайта
# Как получить токен: обратись к @BotFather в Telegram, команда /newbot
TELEGRAM_BOT_TOKEN=

# Chat ID руководителя — куда приходят заявки
# Как узнать chat_id: напиши своему боту, затем открой
# https://api.telegram.org/bot<ТВОЙ_ТОКЕН>/getUpdates
TELEGRAM_CHAT_ID=
